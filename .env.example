# Configuração do Servidor
PORT=8080
APP_ENV=development

# Configurações do SMTP (E-mail)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=seu_usuario
SMTP_PASSWORD=sua_senha
SMTP_SENDER=remetente@exemplo.com

# Configurações do WhatsApp (Z-API)
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token_da_instancia
ZAPI_CLIENT_TOKEN=seu_client_token_opcional

# Configurações do Gemini API
GEMINI_API_KEY=sua_chave_api_do_gemini
GEMINI_MODEL=gemini-3.5-flash

# Configurações do DeepSeek API
DEEPSEEK_API_KEY=sua_chave_api_do_deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER=fallback
