# Configuração do Servidor
PORT=8080
APP_ENV=development

# Configurações do Gemini API
GEMINI_API_KEY=sua_chave_api_do_gemini
GEMINI_MODEL=gemini-3.5-flash

# Configurações do DeepSeek API
DEEPSEEK_API_KEY=sua_chave_api_do_deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER=fallback

# Configurações do Ollama (Vetorização Local)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_BATCH_SIZE=1000

# Monitoramento de grupos
# Tempo de silêncio no grupo antes de processar o lote de mensagens.
# Aceita duração Go: "2m", "10m", "30s". Default: 10m.
# Em desenvolvimento vale baixar para não esperar 10 minutos a cada teste.
GROUP_FLUSH_DEBOUNCE=10m

# Similaridade de cosseno mínima para uma vaga ser enviada à LLM (0.0 a 1.0).
EMBEDDING_THRESHOLD=0.35

# Máximo de vagas enviadas à LLM por match. 0 = sem limite (padrão).
# Quem filtra aptidão é a LLM; o embedding só ordena por similaridade.
MATCH_VACANCY_LIMIT=0

# Prefixos de tarefa do modelo de embedding (padrão: nomic-embed-text).
# As aspas são obrigatórias: sem elas o espaço final é removido no parse.
# Deixe vazio (KEY=) para modelos que não usam prefixo.
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "
