# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Binário compilado na raiz (go build -o main). Ancorado com "/" para não
# ignorar um eventual diretório chamado "main" mais abaixo na árvore.
/main

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, targeted by the generic launch file
*.out

# Dependency directories
vendor/

# IDE / Editor configurations
.idea/
.vscode/

# Environment configurations
.env
.env.local

# Local Database
/db/

# Temporary directories
.tmp_send/

# Log files
log_*.txt
internal/service/log_*.txt
